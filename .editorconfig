# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true


[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true


[*.cs]

indent_style = space
indent_size = 4
tab_width = 4


dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false


csharp_new_line_before_open_brace = all
csharp_new_line_between_query_expression_clauses = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false


dotnet_diagnostic.SAxxxx.severity = none        
dotnet_diagnostic.IDE0001.severity = suggestion
dotnet_diagnostic.IDE0002.severity = suggestion
dotnet_diagnostic.IDE0003.severity = suggestion

# These rules are either framework-inapplicable or intentionally handled by ASP.NET Core.
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1848.severity = suggestion

# EF Core migration files are generated source and should not obscure application diagnostics.
[AuthService.Api/Migrations/*.cs]
dotnet_analyzer_diagnostic.severity = none
