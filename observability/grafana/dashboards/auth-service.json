{
  "title": "Auth Service",
  "schemaVersion": 39,
  "panels": [
    { "title": "API p95", "type": "timeseries", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le))" }] },
    { "title": "5xx rate", "type": "timeseries", "targets": [{ "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m]))" }] },
    { "title": "401/403/429", "type": "timeseries", "targets": [{ "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"401|403|429\"}[5m])) by (http_response_status_code)" }] },
    { "title": "DB latency p95", "type": "timeseries", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(auth_db_command_duration_milliseconds_bucket[5m])) by (le))" }] },
    { "title": "Outbox backlog", "type": "stat", "targets": [{ "expr": "auth_outbox_backlog" }] },
    { "title": "Outbox lag", "type": "stat", "targets": [{ "expr": "auth_outbox_lag_seconds" }] }
  ]
}
