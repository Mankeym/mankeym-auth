# Copy this file to .env and replace placeholders locally. Never commit .env.

# Optional PostgreSQL password for the local Docker stack.
# When omitted, Docker Compose uses a development-only default.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password

# Required outside Development. Store only in a secret manager or local User Secrets.
AUDIT__HASHKEY=replace-with-a-random-32-byte-or-longer-secret
