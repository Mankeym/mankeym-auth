{
  "info": {
    "_postman_id": "2aa916e1-7dab-4a8e-99f8-4dd9e298f7cf",
    "name": "AuthService API",
    "description": "Local API requests. Set the collection variables before sending protected requests. Postman retains the HttpOnly refresh cookie from login automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "email", "value": "user@example.test" },
    { "key": "password", "value": "ReplaceWithLocalPassword123!" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "role", "value": "User" },
    { "key": "confirmationToken", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "provider", "value": "Google" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Live",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/live" }
        },
        {
          "name": "Ready",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.accessToken) { pm.collectionVariables.set('accessToken', body.accessToken); }"] } }]
        },
        {
          "name": "Refresh",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/refresh" },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.accessToken) { pm.collectionVariables.set('accessToken', body.accessToken); }"] } }]
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/logout" }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/reset-password"
          }
        },
        {
          "name": "Confirm email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"token\": \"{{confirmationToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/confirm-email"
          }
        },
        {
          "name": "Request email confirmation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/request-email-confirmation"
          }
        }
      ]
    },
    {
      "name": "User and sessions",
      "item": [
        {
          "name": "My profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/users/me" }
        },
        {
          "name": "My sessions",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/sessions/me" }
        },
        {
          "name": "Revoke session",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}" }
        },
        {
          "name": "Unlink external provider",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/auth/external/{{provider}}" }
        }
      ]
    },
    {
      "name": "Administration",
      "item": [
        {
          "name": "Roles",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/roles" }
        },
        {
          "name": "Role permissions",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/roles/{{role}}/permissions" }
        },
        {
          "name": "Assign role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "\"{{role}}\"" },
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/roles"
          }
        },
        {
          "name": "Remove role",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/users/{{userId}}/roles/{{role}}" }
        },
        {
          "name": "Failed outbox messages",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/outbox/failed" }
        }
      ]
    }
  ]
}
